  "item": [
    {
      "name": "1. Đăng ký / đăng nhập",
      "item": [
        {
          "name": "Đăng ký chủ đồ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Chủ Đồ Thử\",\n  \"email\": \"{{ownerEmail}}\",\n  \"phoneNumber\": \"0900000001\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            },
            "description": "Chỉ chạy nếu chưa có tài khoản. Đổi số điện thoại nếu bị báo trùng."
          }
        },
        {
          "name": "Đăng ký người thuê",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Người Thuê Thử\",\n  \"email\": \"{{renterEmail}}\",\n  \"phoneNumber\": \"0900000002\",\n  \"password\": \"{{renterPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Đăng nhập chủ đồ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/Auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "Auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{ownerPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    pm.collectionVariables.set('tokenOwner', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập người thuê",
