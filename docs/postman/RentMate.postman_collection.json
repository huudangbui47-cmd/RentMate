            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemName\": \"Máy ảnh Canon thử\",\n  \"description\": \"Máy còn tốt, kèm thẻ nhớ và sạc.\",\n  \"pricePerDay\": 150000,\n  \"depositAmount\": 1000000,\n  \"categoryId\": 2,\n  \"condition\": 3,\n  \"province\": \"TP. Hồ Chí Minh\",\n  \"area\": \"Phường Bến Thành\"\n}"
            },
            "description": "categoryId phải là danh mục con (xem request Danh mục). condition: 1 Mới, 2 Như mới, 3 Tốt, 4 Khá, 5 Hư hỏng. Đồ mới ở trạng thái PendingApproval: vào trang quản trị → Đồ cho thuê để duyệt."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
