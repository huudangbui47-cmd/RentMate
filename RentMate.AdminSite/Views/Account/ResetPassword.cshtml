@model ResetPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="admin-login-heading">
    <h1>Đặt mật khẩu mới</h1>
    <p>Mật khẩu mới phải khác mật khẩu hiện tại.</p>
</div>

<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        @* value giữ lại mật khẩu đã nhập khi máy chủ báo lỗi *@
        <div class="rm-password-field">
            <input asp-for="NewPassword" type="password" value="@Model.NewPassword" class="form-control" autocomplete="new-password" autofocus />
            <partial name="_PasswordToggle" />
        </div>
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <div class="rm-password-field">
            <input asp-for="ConfirmPassword" type="password" value="@Model.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <partial name="_PasswordToggle" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Đặt mật khẩu mới</button>

    <div class="text-center mt-3">
        <a asp-action="Login" class="small">Quay lại đăng nhập</a>
    </div>
</form>
