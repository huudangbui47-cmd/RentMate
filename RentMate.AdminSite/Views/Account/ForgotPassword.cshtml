@model ForgotPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="admin-login-heading">
    <h1>Quên mật khẩu</h1>
    <p>Nhập email tài khoản quản trị của bạn. Chúng tôi sẽ gửi link để đặt mật khẩu mới.</p>
</div>

<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Gửi link đặt lại mật khẩu</button>

    <div class="text-center mt-3">
        <a asp-action="Login" class="small">Quay lại đăng nhập</a>
    </div>
</form>
