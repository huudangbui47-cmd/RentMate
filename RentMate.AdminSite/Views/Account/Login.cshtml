@model LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng nhập";
}

<div class="admin-login-heading">
    <h1>Đăng nhập</h1>
    <p>Dành cho tài khoản Quản trị viên và Quản lý.</p>
</div>

<form asp-controller="Account" asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" placeholder="Nhập email" autocomplete="email" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="rm-password-field">
            <input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" />
            <partial name="_PasswordToggle" />
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <label class="form-check mb-0">
            <input asp-for="RememberMe" class="form-check-input" />
            <span class="form-check-label">Giữ đăng nhập trong 7 ngày</span>
        </label>
        <a asp-action="ForgotPassword" class="small">Quên mật khẩu?</a>
    </div>

    <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
</form>
