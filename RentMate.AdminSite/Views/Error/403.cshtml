@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Không có quyền truy cập</title>
    <script>
        try { if (localStorage.getItem("rm-theme") === "dark") document.documentElement.setAttribute("data-bs-theme", "dark"); } catch (e) { }
    </script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/tabler/css/tabler.min.css" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
</head>
<body class="admin-login-page">
    <div class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <div class="card error-card text-center">
            <div class="card-body p-5">
                <div class="error-code">403</div>
                <h2 class="mb-3">Không có quyền truy cập</h2>
                <p class="text-muted mb-4">Tài khoản của bạn không có quyền sử dụng chức năng này.</p>
                <a asp-area="Management" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Quay lại hệ thống</a>
            </div>
        </div>
    </div>
</body>
</html>
