@model RentalListViewModel

@{
    ViewData["Title"] = "Đơn thuê";
}

<div class="page-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <h3>Đơn thuê</h3>
    </div>
</div>

<form method="get" asp-action="Index" class="admin-toolbar">
    <div class="admin-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input asp-for="SearchTerm" name="searchTerm" class="form-control" placeholder="Tìm mã đơn, tên đồ, người thuê, chủ đồ..." autocomplete="off" />
    </div>
    <div class="admin-filterbar">
        <select name="status" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="@RentalStatus.Pending" selected="@(Model.Status == RentalStatus.Pending)">Chờ duyệt</option>
            <option value="@RentalStatus.Approved" selected="@(Model.Status == RentalStatus.Approved)">Đã duyệt</option>
            <option value="@RentalStatus.WaitingForPickup" selected="@(Model.Status == RentalStatus.WaitingForPickup)">Chờ nhận đồ</option>
            <option value="@RentalStatus.Rented" selected="@(Model.Status == RentalStatus.Rented)">Đang thuê</option>
            <option value="@RentalStatus.Returned" selected="@(Model.Status == RentalStatus.Returned)">Đã trả đồ</option>
            <option value="@RentalStatus.Completed" selected="@(Model.Status == RentalStatus.Completed)">Hoàn tất</option>
            <option value="@RentalStatus.Overdue" selected="@(Model.Status == RentalStatus.Overdue)">Quá hạn</option>
            <option value="@RentalStatus.Rejected" selected="@(Model.Status == RentalStatus.Rejected)">Từ chối</option>
            <option value="@RentalStatus.Cancelled" selected="@(Model.Status == RentalStatus.Cancelled)">Đã hủy</option>
        </select>
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.Status.HasValue)
        {
            <a asp-action="Index" class="admin-clear-link">Xóa lọc</a>
        }
    </div>
</form>

<div class="card admin-table-card">
    <div class="table-responsive admin-table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Mã đơn</th>
                    <th>Đồ thuê</th>
                    <th>Người thuê</th>
                    <th>Chủ đồ</th>
                    <th>Thời gian thuê</th>
                    <th class="text-end">Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rentals.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Không tìm thấy đơn thuê.</td></tr>
                }
                @foreach (var item in Model.Rentals)
                {
                    string badgeClass = item.Status switch
                    {
                        RentalStatus.Pending => "admin-badge-warning",
                        RentalStatus.Approved or RentalStatus.WaitingForPickup or RentalStatus.Returned => "admin-badge-info",
                        RentalStatus.Rented => "admin-badge-primary",
                        RentalStatus.Completed => "admin-badge-success",
                        RentalStatus.Rejected or RentalStatus.Overdue => "admin-badge-danger",
                        _ => "admin-badge-muted"
                    };
                    <tr>
                        <td class="fw-semibold">#@item.Id</td>
                        <td>
                            <div class="fw-semibold">@item.ItemName</div>
                            <small class="text-muted">Tạo lúc @item.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        </td>
                        <td>@item.RenterName</td>
                        <td>@item.OwnerName</td>
                        <td class="text-muted">@item.StartDate.ToString("dd/MM/yyyy") – @item.EndDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-end fw-semibold">@item.TotalPrice.ToString("N0") đ</td>
                        <td><span class="admin-badge @badgeClass">@item.StatusText</span></td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn admin-row-primary">Chi tiết</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Phân trang" class="d-flex flex-wrap gap-2 justify-content-center mt-3">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-status="@Model.Status"
               class="btn @(Model.Page == i ? "btn-primary" : "btn-outline-primary")" aria-current="@(Model.Page == i ? "page" : null)">@i</a>
        }
    </nav>
}
