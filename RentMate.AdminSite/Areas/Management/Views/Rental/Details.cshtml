@model RentalDetailsViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = $"Đơn thuê #{Model.Id}";

    // Ảnh biên bản nằm trên Api (wwwroot/uploads/reports); chỉ nhận ảnh upload hoặc link http(s)
    string apiBaseUrl = (Configuration["ApiBaseUrl"] ?? "https://localhost:7130").TrimEnd('/');

    string? ToImageSrc(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return null;

        if (url.StartsWith("/uploads/", StringComparison.OrdinalIgnoreCase))
            return apiBaseUrl + url;

        return Uri.TryCreate(url, UriKind.Absolute, out var uri)
            && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps) ? url : null;
    }

    var timeline = new (string Label, DateTime? At)[]
    {
        ("Tạo yêu cầu", Model.RequestedAt),
        ("Chủ đồ duyệt", Model.ApprovedAt),
        ("Người thuê nhận đồ", Model.ReceivedAt),
        ("Người thuê trả đồ", Model.ReturnedAt),
        ("Chủ đồ yêu cầu bồi thường", Model.DamageClaimedAt),
        ("Người thuê khiếu nại", Model.DisputedAt),
        ("Hoàn tất", Model.CompletedAt)
    };
}

<div class="page-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="mb-1">Đơn thuê #@Model.Id</h3>
            <span class="admin-badge admin-badge-primary">@Model.StatusText</span>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><h4 class="mb-0">Thông tin đơn thuê</h4></div>
            <div class="card-body">
                <dl class="row mb-0 rm-detail-list">
                    <dt class="col-sm-4">Đồ thuê</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.ItemName <small class="text-muted">(@Model.CategoryName)</small></dd>

                    <dt class="col-sm-4">Thời gian thuê</dt>
                    <dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy") – @Model.EndDate.ToString("dd/MM/yyyy") (@Model.NumberOfDays ngày)</dd>

                    <dt class="col-sm-4">Giá thuê/ngày</dt>
                    <dd class="col-sm-8">@Model.PricePerDay.ToString("N0") đ</dd>

                    <dt class="col-sm-4">Tiền cọc</dt>
                    <dd class="col-sm-8">@Model.DepositAmount.ToString("N0") đ</dd>

                    <dt class="col-sm-4">Tổng phí thuê</dt>
                    <dd class="col-sm-8 fw-bold">@Model.TotalPrice.ToString("N0") đ</dd>

                    <dt class="col-sm-4">Ghi chú</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.RequestNote) ? "—" : Model.RequestNote)</dd>

                    <dt class="col-sm-4">Giao nhận</dt>
                    <dd class="col-sm-8">
                        @Model.DeliveryMethodText
                        @if (Model.ShippingOrderCode != null)
                        {
                            <span class="text-muted">· mã vận đơn @Model.ShippingOrderCode@(Model.ShippingFee.HasValue ? $" · phí {Model.ShippingFee.Value:N0} đ" : "")</span>
                        }
                        @if (Model.ShipToText != null)
                        {
                            <div class="text-muted small">@Model.ShipToText</div>
                        }
                    </dd>

                    @if (Model.ShiftedDays > 0 || Model.LateDeliveryRefund > 0)
                    {
                        <dt class="col-sm-4">Nhận đồ trễ</dt>
                        <dd class="col-sm-8">
                            @(Model.ShiftedDays > 0
                                ? $"Lùi hạn trả {Model.ShiftedDays} ngày"
                                : $"Hoàn {Model.LateDeliveryRefund:N0} đ tiền thuê (vướng lịch thuê sau)")
                        </dd>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
                    {
                        <dt class="col-sm-4">Lý do hủy</dt>
                        <dd class="col-sm-8">@Model.CancelReason</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h4 class="mb-0">Tiến trình</h4></div>
            <div class="card-body">
                <ul class="rm-timeline">
                    @foreach (var step in timeline)
                    {
                        <li class="@(step.At.HasValue ? "done" : "")">
                            <span class="rm-timeline-label">@step.Label</span>
                            <small class="text-muted">@(step.At.HasValue ? step.At.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</small>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><h4 class="mb-0">Người thuê</h4></div>
            <div class="card-body">
                <div class="fw-semibold">@Model.RenterName</div>
                <div class="text-muted">@Model.RenterEmail</div>
                <div class="text-muted">@Model.RenterPhone</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><h4 class="mb-0">Chủ đồ</h4></div>
            <div class="card-body">
                <div class="fw-semibold">@Model.OwnerName</div>
                <div class="text-muted">@Model.OwnerEmail</div>
                <div class="text-muted">@Model.OwnerPhone</div>
            </div>
        </div>
    </div>
</div>

@if (Model.HasDamageClaim)
{
    <div class="card mb-4 @(Model.Status == RentalStatus.Disputed ? "border border-danger" : "")">
        <div class="card-header"><h4 class="mb-0">Bồi thường hư hỏng</h4></div>
        <div class="card-body">
            <dl class="row mb-0 rm-detail-list">
                <dt class="col-sm-4">Chủ đồ đề nghị trừ</dt>
                <dd class="col-sm-8 fw-bold">@Model.DamageAmount.ToString("N0") đ <small class="text-muted">/ cọc @Model.DepositAmount.ToString("N0") đ</small></dd>

                <dt class="col-sm-4">Lý do của chủ đồ</dt>
                <dd class="col-sm-8">@(Model.DamageNote ?? "—")</dd>

                @if (!string.IsNullOrWhiteSpace(Model.DisputeReason))
                {
                    <dt class="col-sm-4">Người thuê khiếu nại</dt>
                    <dd class="col-sm-8">@Model.DisputeReason</dd>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ResolutionNote))
                {
                    <dt class="col-sm-4">Kết luận phân xử</dt>
                    <dd class="col-sm-8">@Model.ResolutionNote</dd>
                }
            </dl>

            @if (Model.Status == RentalStatus.Disputed)
            {
                <hr />
                <p class="text-muted mb-3">Xem ảnh hai biên bản và nhận xét của AI bên dưới, rồi chốt số tiền trừ cọc. Phần cọc còn lại hoàn cho người thuê, chủ đồ nhận tiền thuê (trừ phí 5%) cộng tiền bồi thường.</p>
                <form asp-action="ResolveDispute" asp-route-id="@Model.Id" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label class="form-label" for="damageAmount">Số tiền trừ cọc (đ)</label>
                        <input type="number" class="form-control" id="damageAmount" name="damageAmount" min="0" max="@Model.DepositAmount.ToString("0")" step="1000" value="@Model.DamageAmount.ToString("0")" required />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="note">Kết luận gửi hai bên</label>
                        <textarea class="form-control" id="note" name="note" rows="2" maxlength="1000" required></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Chốt kết quả và chia tiền</button>
                    </div>
                </form>
            }
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header"><h4 class="mb-0">Thanh toán</h4></div>
    <div class="table-responsive admin-table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Loại</th>
                    <th>Phương thức</th>
                    <th class="text-end">Số tiền</th>
                    <th>Mã giao dịch</th>
                    <th>Thời điểm thanh toán</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Payments.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có giao dịch.</td></tr>
                }
                @foreach (var payment in Model.Payments)
                {
                    <tr>
                        <td>@payment.TypeText</td>
                        <td>@payment.MethodText</td>
                        <td class="text-end fw-semibold">@payment.Amount.ToString("N0") đ</td>
                        <td><code>@payment.TransactionCode</code></td>
                        <td class="text-muted">@(payment.PaidAt.HasValue ? payment.PaidAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</td>
                        <td><span class="admin-badge @(payment.Status == PaymentStatus.Paid ? "admin-badge-success" : "admin-badge-warning")">@payment.StatusText</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header"><h4 class="mb-0">Biên bản tình trạng đồ</h4></div>
    <div class="card-body">
        @if (Model.ConditionReports.Count == 0)
        {
            <p class="text-muted mb-0">Chưa có biên bản.</p>
        }
        <div class="row g-3">
            @foreach (var report in Model.ConditionReports)
            {
                var safeImageUrls = report.ImageUrls
                    .Select(ToImageSrc)
                    .Where(src => src != null)
                    .ToList();

                <div class="col-md-6">
                    <div class="rm-report">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>@report.ReportTypeText</strong>
                            <span class="admin-badge admin-badge-info">@report.ConditionText</span>
                        </div>
                        <p class="mb-2">@(string.IsNullOrWhiteSpace(report.Description) ? "Không có mô tả." : report.Description)</p>
                        <small class="text-muted">@report.CreatedByName · @report.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        @if (!string.IsNullOrWhiteSpace(report.AiSummary))
                        {
                            <div class="rm-ai-box mt-2">
                                <div class="fw-semibold mb-1">AI nhận xét @(report.AiConditionText != null ? $"· gợi ý tình trạng: {report.AiConditionText}" : "")</div>
                                @if (report.AiSameItem == false)
                                {
                                    <div class="text-danger fw-semibold mb-1">⚠ AI thấy đồ trong ảnh có thể khác món đã đăng / đã giao</div>
                                }
                                <p class="mb-1">@report.AiSummary</p>
                                @if (report.AiDamageList.Count > 0)
                                {
                                    <ul class="mb-1">
                                        @foreach (var damage in report.AiDamageList)
                                        {
                                            <li>@damage</li>
                                        }
                                    </ul>
                                }
                                @if (report.AiSuggestedDeduction.HasValue)
                                {
                                    <div>Gợi ý trừ cọc: <strong>@report.AiSuggestedDeduction.Value.ToString("N0") đ</strong></div>
                                }
                                <small class="text-muted">Chỉ là gợi ý, có thể sai do ánh sáng hoặc góc chụp.</small>
                            </div>
                        }
                        @if (safeImageUrls.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var url in safeImageUrls)
                                {
                                    <a href="@url" target="_blank" rel="noopener noreferrer">
                                        <img src="@url" alt="Ảnh biên bản" class="admin-product-thumb" />
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
