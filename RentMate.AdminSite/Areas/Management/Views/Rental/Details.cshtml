@model RentalDetailsViewModel

@{
    ViewData["Title"] = $"Đơn thuê #{Model.Id}";

    var timeline = new (string Label, DateTime? At)[]
    {
        ("Tạo yêu cầu", Model.RequestedAt),
        ("Chủ đồ duyệt", Model.ApprovedAt),
        ("Người thuê nhận đồ", Model.ReceivedAt),
        ("Người thuê trả đồ", Model.ReturnedAt),
        ("Hoàn tất", Model.CompletedAt)
    };
}

<div class="page-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h3 class="mb-1">Đơn thuê #@Model.Id</h3>
            <span class="admin-badge admin-badge-primary">@Model.StatusText</span>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header"><h4 class="mb-0">Thông tin đơn thuê</h4></div>
            <div class="card-body">
                <dl class="row mb-0 rm-detail-list">
                    <dt class="col-sm-4">Đồ thuê</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.ItemName <small class="text-muted">(@Model.CategoryName)</small></dd>

                    <dt class="col-sm-4">Thời gian thuê</dt>
                    <dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy") – @Model.EndDate.ToString("dd/MM/yyyy") (@Model.NumberOfDays ngày)</dd>

                    <dt class="col-sm-4">Giá thuê/ngày</dt>
                    <dd class="col-sm-8">@Model.PricePerDay.ToString("N0") đ</dd>

                    <dt class="col-sm-4">Tiền cọc</dt>
                    <dd class="col-sm-8">@Model.DepositAmount.ToString("N0") đ</dd>

                    <dt class="col-sm-4">Tổng phí thuê</dt>
                    <dd class="col-sm-8 fw-bold">@Model.TotalPrice.ToString("N0") đ</dd>

                    <dt class="col-sm-4">Ghi chú</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.RequestNote) ? "—" : Model.RequestNote)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><h4 class="mb-0">Tiến trình</h4></div>
            <div class="card-body">
                <ul class="rm-timeline">
                    @foreach (var step in timeline)
                    {
                        <li class="@(step.At.HasValue ? "done" : "")">
                            <span class="rm-timeline-label">@step.Label</span>
                            <small class="text-muted">@(step.At.HasValue ? step.At.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</small>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><h4 class="mb-0">Người thuê</h4></div>
            <div class="card-body">
                <div class="fw-semibold">@Model.RenterName</div>
                <div class="text-muted">@Model.RenterEmail</div>
                <div class="text-muted">@Model.RenterPhone</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><h4 class="mb-0">Chủ đồ</h4></div>
            <div class="card-body">
                <div class="fw-semibold">@Model.OwnerName</div>
                <div class="text-muted">@Model.OwnerEmail</div>
                <div class="text-muted">@Model.OwnerPhone</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h4 class="mb-0">Thanh toán</h4></div>
    <div class="table-responsive admin-table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Loại</th>
                    <th>Phương thức</th>
                    <th class="text-end">Số tiền</th>
                    <th>Mã giao dịch</th>
                    <th>Thời điểm thanh toán</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Payments.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Chưa có giao dịch.</td></tr>
                }
                @foreach (var payment in Model.Payments)
                {
                    <tr>
                        <td>@payment.TypeText</td>
                        <td>@payment.MethodText</td>
                        <td class="text-end fw-semibold">@payment.Amount.ToString("N0") đ</td>
                        <td><code>@payment.TransactionCode</code></td>
                        <td class="text-muted">@(payment.PaidAt.HasValue ? payment.PaidAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")</td>
                        <td><span class="admin-badge @(payment.Status == PaymentStatus.Paid ? "admin-badge-success" : "admin-badge-warning")">@payment.StatusText</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header"><h4 class="mb-0">Biên bản tình trạng đồ</h4></div>
    <div class="card-body">
        @if (Model.ConditionReports.Count == 0)
        {
            <p class="text-muted mb-0">Chưa có biên bản.</p>
        }
        <div class="row g-3">
            @foreach (var report in Model.ConditionReports)
            {
                // Ảnh do người dùng app gửi lên: chỉ nhận link http(s) để tránh chèn "javascript:"
                var safeImageUrls = report.ImageUrls
                    .Where(url => Uri.TryCreate(url, UriKind.Absolute, out var uri)
                        && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))
                    .ToList();

                <div class="col-md-6">
                    <div class="rm-report">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>@report.ReportTypeText</strong>
                            <span class="admin-badge admin-badge-info">@report.ConditionText</span>
                        </div>
                        <p class="mb-2">@(string.IsNullOrWhiteSpace(report.Description) ? "Không có mô tả." : report.Description)</p>
                        <small class="text-muted">@report.CreatedByName · @report.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                        @if (safeImageUrls.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var url in safeImageUrls)
                                {
                                    <a href="@url" target="_blank" rel="noopener noreferrer">
                                        <img src="@url" alt="Ảnh biên bản" class="admin-product-thumb" />
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
