@using System.Text.Json
@model IEnumerable<CategoryViewModel>

@{
    ViewData["Title"] = "Danh mục";
    var parentOptions = ViewData["ParentOptions"] as List<CategoryOptionViewModel> ?? new();
}

<div class="page-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <h3>Danh mục</h3>
        <a asp-action="Create" class="btn btn-primary admin-btn-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            Thêm danh mục
        </a>
    </div>
</div>

<div class="admin-toolbar">
    <div class="admin-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" class="form-control" placeholder="Tìm danh mục..." data-client-search="categories" autocomplete="off" />
    </div>
    <div class="admin-filterbar">
        <select class="form-select" data-client-filter="categories" data-field="status">
            <option value="">Tất cả trạng thái</option>
            <option value="active">Đang hoạt động</option>
            <option value="inactive">Ngừng hoạt động</option>
        </select>
    </div>
</div>

<div class="card admin-table-card">
    <div class="table-responsive admin-table-responsive">
        <table class="table admin-table" data-client-table="categories">
            <thead>
                <tr>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th class="text-center">Số đồ</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có danh mục.</td></tr>
                }
                @foreach (var item in Model)
                {
                    bool isChild = item.ParentCategoryId != null;
                    <tr data-search="@item.CategoryName @item.ParentCategoryName @item.Description" data-status="@(item.IsActive ? "active" : "inactive")">
                        <td>
                            @if (isChild)
                            {
                                <span class="rm-category-child">@item.CategoryName</span>
                            }
                            else
                            {
                                <span class="fw-semibold">@item.CategoryName</span>
                                @if (item.ChildCount > 0)
                                {
                                    <span class="text-muted small ms-1">(@item.ChildCount danh mục con)</span>
                                }
                            }
                        </td>
                        <td class="text-muted">@item.Description</td>
                        <td class="text-center">@item.ItemCount</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="admin-badge admin-badge-success">Đang hoạt động</span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-muted">Ngừng hoạt động</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="admin-row-actions">
                                @{
                                    string editValues = JsonSerializer.Serialize(new
                                    {
                                        Id = item.Id,
                                        RowVersion = item.RowVersion,
                                        CategoryName = item.CategoryName,
                                        Description = item.Description,
                                        ParentCategoryId = item.ParentCategoryId
                                    });
                                    string toggleTitle = item.IsActive ? "Ngừng hoạt động danh mục" : "Mở lại hoạt động danh mục";
                                    string toggleConfirm = item.IsActive
                                        ? (item.ChildCount > 0 ? "Ngừng hoạt động danh mục này? Các danh mục con cũng sẽ ngừng hoạt động." : "Ngừng hoạt động danh mục này?")
                                        : "Mở lại hoạt động danh mục này?";
                                }
                                <button type="button" class="btn admin-row-primary" data-edit-modal="#categoryEditModal" data-edit-values="@editValues">Sửa</button>

                                @if (!isChild)
                                {
                                    <a asp-action="Create" asp-route-parentId="@item.Id" class="rm-icon-button" title="Thêm danh mục con" aria-label="Thêm danh mục con">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                    </a>
                                }

                                @if (item.IsActive && item.ItemCount > 0)
                                {
                                    @* Đang có đồ thì không được ngừng hoạt động *@
                                    <span class="rm-row-action-form" title="Đang có @item.ItemCount đồ cho thuê nên không thể ngừng hoạt động">
                                        <button type="button" class="rm-icon-button" disabled aria-label="Không thể ngừng hoạt động danh mục đang có đồ">
                                            <partial name="_LockIcon" model="item.IsActive" />
                                        </button>
                                    </span>
                                }
                                else
                                {
                                    <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="rm-row-action-form"
                                          onsubmit="return confirm('@toggleConfirm');">
                                        <input type="hidden" name="isActive" value="@(item.IsActive ? "false" : "true")" />
                                        <button type="submit" class="rm-icon-button @(item.IsActive ? "" : "rm-icon-locked")" title="@toggleTitle" aria-label="@toggleTitle">
                                            <partial name="_LockIcon" model="item.IsActive" />
                                        </button>
                                    </form>
                                }

                                @if (item.ItemCount == 0 && item.ChildCount == 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="rm-row-action-form"
                                          onsubmit="return confirm('Xóa danh mục này?');">
                                        <button type="submit" class="rm-icon-button rm-icon-danger" title="Xóa danh mục" aria-label="Xóa danh mục">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" /></svg>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    @* span bọc ngoài để tooltip vẫn hiện khi nút bị vô hiệu *@
                                    string deleteBlockedReason = item.ChildCount > 0
                                        ? $"Danh mục đang có {item.ChildCount} danh mục con nên không thể xóa"
                                        : $"Danh mục đang có {item.ItemCount} đồ cho thuê nên không thể xóa";
                                    <span class="rm-row-action-form" title="@deleteBlockedReason">
                                        <button type="button" class="rm-icon-button" disabled aria-label="@deleteBlockedReason">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" /></svg>
                                        </button>
                                    </span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="categoryEditModal" tabindex="-1" aria-labelledby="categoryEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Edit" method="post" data-edit-form>
                <div class="modal-header">
                    <h5 class="modal-title" id="categoryEditModalLabel">Sửa danh mục</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="Id" />
                    <input type="hidden" name="RowVersion" />

                    <div class="mb-3">
                        <label for="categoryEditName" class="form-label">Tên danh mục</label>
                        <input type="text" id="categoryEditName" name="CategoryName" maxlength="100" class="form-control" autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label for="categoryEditParent" class="form-label">Thuộc danh mục</label>
                        <select id="categoryEditParent" name="ParentCategoryId" class="form-select">
                            <option value="">Không có (đây là danh mục cha)</option>
                            @foreach (var option in parentOptions)
                            {
                                <option value="@option.Id">@option.CategoryName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-2">
                        <label for="categoryEditDescription" class="form-label">Mô tả</label>
                        <textarea id="categoryEditDescription" name="Description" rows="3" maxlength="500" class="form-control"></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
