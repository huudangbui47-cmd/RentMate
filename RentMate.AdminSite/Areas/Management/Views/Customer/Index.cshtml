@using System.Text.Json
@model CustomerListViewModel

@{
    ViewData["Title"] = "Khách hàng";
}

<div class="page-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <h3>Khách hàng</h3>
        <a asp-action="Create" class="btn btn-primary admin-btn-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            Thêm khách hàng
        </a>
    </div>
</div>

@if (TempData["TemporaryPassword"] != null)
{
    <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2" role="alert">
        <div>
            Mật khẩu tạm của <strong>@TempData["TemporaryPasswordFor"]</strong>:
            <code class="fs-6">@TempData["TemporaryPassword"]</code>
            <div class="small">Mật khẩu chỉ hiện một lần. Hãy báo cho khách và nhắc khách đổi mật khẩu sau khi đăng nhập.</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<form method="get" asp-action="Index" class="admin-toolbar">
    <div class="admin-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input asp-for="SearchTerm" name="searchTerm" class="form-control" placeholder="Tìm tên, email hoặc số điện thoại..." autocomplete="off" />
    </div>
    <div class="admin-filterbar">
        <select name="isActive" class="form-select">
            <option value="">Tất cả trạng thái</option>
            <option value="true" selected="@(Model.IsActive == true)">Hoạt động</option>
            <option value="false" selected="@(Model.IsActive == false)">Đã khóa</option>
        </select>
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.IsActive.HasValue)
        {
            <a asp-action="Index" class="admin-clear-link">Xóa lọc</a>
        }
    </div>
</form>

<div class="card admin-table-card">
    <div class="table-responsive admin-table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Liên hệ</th>
                    <th class="text-center">Đồ đăng</th>
                    <th class="text-center">Lượt thuê</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Customers.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy khách hàng.</td></tr>
                }
                @foreach (var item in Model.Customers)
                {
                    <tr>
                        <td class="fw-semibold">
                            @item.FullName
                            @if (!string.IsNullOrEmpty(item.Address))
                            {
                                <div class="small text-muted fw-normal">@item.Address</div>
                            }
                        </td>
                        <td>
                            <div>@item.Email</div>
                            <small class="text-muted">@item.PhoneNumber</small>
                        </td>
                        <td class="text-center">@item.ItemCount</td>
                        <td class="text-center">@item.RentalCount</td>
                        <td class="text-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="admin-badge admin-badge-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-danger">Đã khóa</span>
                            }
                        </td>
                        <td class="text-end">
                            @{
                                string editValues = JsonSerializer.Serialize(new
                                {
                                    Id = item.Id,
                                    FullName = item.FullName,
                                    Email = item.Email,
                                    PhoneNumber = item.PhoneNumber,
                                    Address = item.Address
                                });
                                string lockTitle = item.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản";
                            }
                            <div class="admin-row-actions">
                                <button type="button" class="btn admin-row-primary" data-edit-modal="#customerEditModal" data-edit-values="@editValues">Sửa</button>

                                <form asp-action="ResetPassword" asp-route-id="@item.Id" method="post" class="rm-row-action-form"
                                      onsubmit="return confirm('Đặt lại mật khẩu cho khách hàng này? Mật khẩu cũ sẽ không dùng được nữa.');">
                                    <button type="submit" class="rm-icon-button" title="Đặt lại mật khẩu" aria-label="Đặt lại mật khẩu">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="15" r="4" /><path d="m11 12 9-9M17 6l3 3M15 8l2 2" /></svg>
                                    </button>
                                </form>

                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="rm-row-action-form"
                                      onsubmit="return confirm('@(item.IsActive ? "Khóa khách hàng này?" : "Mở khóa khách hàng này?")');">
                                    <button type="submit" class="rm-icon-button @(item.IsActive ? "" : "rm-icon-locked")" title="@lockTitle" aria-label="@lockTitle">
                                        <partial name="_LockIcon" model="item.IsActive" />
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Phân trang" class="d-flex flex-wrap gap-2 justify-content-center mt-3">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@Model.SearchTerm" asp-route-isActive="@Model.IsActive"
               class="btn @(Model.Page == i ? "btn-primary" : "btn-outline-primary")" aria-current="@(Model.Page == i ? "page" : null)">@i</a>
        }
    </nav>
}

<div class="modal fade" id="customerEditModal" tabindex="-1" aria-labelledby="customerEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Edit" method="post" data-edit-form>
                <div class="modal-header">
                    <h5 class="modal-title" id="customerEditModalLabel">Sửa thông tin khách hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="Id" />

                    <div class="mb-3">
                        <label for="customerEditFullName" class="form-label">Họ tên</label>
                        <input type="text" id="customerEditFullName" name="FullName" maxlength="100" class="form-control" autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label for="customerEditEmail" class="form-label">Email</label>
                        <input type="email" id="customerEditEmail" name="Email" maxlength="100" class="form-control" autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label for="customerEditPhone" class="form-label">Số điện thoại</label>
                        <input type="tel" id="customerEditPhone" name="PhoneNumber" maxlength="10" class="form-control" autocomplete="off" />
                    </div>

                    <div class="mb-2">
                        <label for="customerEditAddress" class="form-label">Địa chỉ</label>
                        <input type="text" id="customerEditAddress" name="Address" maxlength="200" class="form-control" autocomplete="off" />
                    </div>

                    <div class="form-text">Mật khẩu không sửa ở đây. Dùng nút hình chìa khóa để đặt lại mật khẩu.</div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>
