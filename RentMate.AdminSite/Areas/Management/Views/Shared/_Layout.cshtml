@using System.Security.Claims

@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string displayName = User.Identity?.Name ?? "Người dùng";
    string userInitial = displayName.Length > 0 ? displayName[..1].ToUpperInvariant() : "U";
    string? avatarUrl = User.FindFirstValue("AvatarUrl");
    bool isAdmin = User.IsInRole("Admin");
    string roleDisplayName = isAdmin ? "Quản trị viên" : "Quản lý";

    string ItemClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "sidebar-item active" : "sidebar-item";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentMate Admin</title>
    <link rel="icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="~/lib/mazer/css/app.css" />
    <link rel="stylesheet" href="~/lib/mazer/css/app-dark.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rentmate.css" asp-append-version="true" />

    <script>
        if (!localStorage.getItem("theme")) localStorage.setItem("theme", "light");
    </script>
</head>
<body>
    <script src="~/lib/mazer/js/initTheme.js"></script>

    <div id="app">
        <div id="sidebar">
            <div class="sidebar-wrapper active admin-sidebar-wrapper">
                <div class="sidebar-header position-relative">
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-area="Management" asp-controller="Dashboard" asp-action="Index" class="mazer-brand">
                            <span class="mazer-brand-mark">RM</span>
                            <span>
                                <strong>RentMate</strong>
                                <small>Trang quản trị</small>
                            </span>
                        </a>

                        <div class="sidebar-toggler x">
                            <a href="#" class="sidebar-hide d-xl-none d-block">×</a>
                        </div>
                    </div>
                </div>

                <div class="sidebar-menu admin-sidebar-menu">
                    <ul class="menu">
                        <li class="sidebar-title">Tổng quan</li>
                        <li class="@ItemClass("Dashboard")">
                            <a asp-area="Management" asp-controller="Dashboard" asp-action="Index" class="sidebar-link">
                                <span class="mazer-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg></span>
                                <span>Tổng quan</span>
                            </a>
                        </li>

                        <li class="sidebar-title">Cho thuê</li>
                        <li class="@ItemClass("Rental")">
                            <a asp-area="Management" asp-controller="Rental" asp-action="Index" class="sidebar-link">
                                <span class="mazer-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z" /><path d="M9 8h6M9 12h6M9 16h4" /></svg></span>
                                <span>Đơn thuê</span>
                            </a>
                        </li>
                        <li class="@ItemClass("Item")">
                            <a asp-area="Management" asp-controller="Item" asp-action="Index" class="sidebar-link">
                                <span class="mazer-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" /><path d="m4.5 7.8 7.5 4.3 7.5-4.3M12 12.1V21" /></svg></span>
                                <span>Đồ cho thuê</span>
                            </a>
                        </li>
                        <li class="@ItemClass("Category")">
                            <a asp-area="Management" asp-controller="Category" asp-action="Index" class="sidebar-link">
                                <span class="mazer-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10" /></svg></span>
                                <span>Danh mục</span>
                            </a>
                        </li>
                        <li class="@ItemClass("Payment")">
                            <a asp-area="Management" asp-controller="Payment" asp-action="Index" class="sidebar-link">
                                <span class="mazer-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18M7 15h4" /></svg></span>
                                <span>Thanh toán</span>
                            </a>
                        </li>

                        <li class="sidebar-title">Khách hàng</li>
                        <li class="@ItemClass("Customer")">
                            <a asp-area="Management" asp-controller="Customer" asp-action="Index" class="sidebar-link">
                                <span class="mazer-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3" /><path d="M3.5 20a5.5 5.5 0 0 1 11 0" /><circle cx="17" cy="9" r="2.5" /><path d="M15.5 15.5A4.5 4.5 0 0 1 21 20" /></svg></span>
                                <span>Khách hàng</span>
                            </a>
                        </li>

                        @if (isAdmin)
                        {
                            <li class="sidebar-title">Quản trị</li>
                            <li class="@ItemClass("User")">
                                <a asp-area="Management" asp-controller="User" asp-action="Index" class="sidebar-link">
                                    <span class="mazer-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /><path d="m17 4 1.5 1.5L21 3" /></svg></span>
                                    <span>Tài khoản quản lý</span>
                                </a>
                            </li>
                            <li class="@ItemClass("AuditLog")">
                                <a asp-area="Management" asp-controller="AuditLog" asp-action="Index" class="sidebar-link">
                                    <span class="mazer-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2M7 4.5 5 2.5M17 4.5l2-2" /></svg></span>
                                    <span>Nhật ký hệ thống</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="sidebar-account dropup">
                        <button type="button" class="sidebar-account-button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="mazer-avatar" id="currentUserAvatar" data-initial="@userInitial">
                                @if (!string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img src="@avatarUrl" alt="Ảnh đại diện" />
                                }
                                else
                                {
                                    @userInitial
                                }
                            </span>
                            <span class="sidebar-account-line">
                                <strong id="currentUserName">@displayName</strong>
                                <span class="sidebar-account-dot">·</span>
                                <small>@roleDisplayName</small>
                            </span>
                            <span class="sidebar-account-chevron">⌃</span>
                        </button>
                        <ul class="dropdown-menu shadow sidebar-account-menu">
                            <li>
                                <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#accountProfileModal">Thông tin tài khoản</button>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">Đăng xuất</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>

        <div id="main" class="admin-main">
            <a href="#" class="burger-btn d-block d-xl-none admin-mobile-burger" aria-label="Mở menu">☰</a>

            <div class="admin-theme-control" title="Chuyển chế độ sáng / tối">
                <span class="admin-theme-icon">☀</span>
                <div class="form-check form-switch mb-0">
                    <input class="form-check-input me-0" type="checkbox" id="toggle-dark" aria-label="Chuyển chế độ sáng hoặc tối" />
                </div>
                <span class="admin-theme-icon">☾</span>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger admin-error-toast admin-toast show" role="alert">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success admin-error-toast admin-toast show" role="status">@TempData["Success"]</div>
            }

            <main class="mazer-content admin-main-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_AccountProfileModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/mazer/js/dark.js"></script>
    <script src="~/lib/mazer/js/perfect-scrollbar.min.js"></script>
    <script src="~/lib/mazer/js/app.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin-ui.js" asp-append-version="true"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script src="~/js/edit-modal.js" asp-append-version="true"></script>
    <script src="~/js/account-profile.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
