@using System.Security.Claims

@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string displayName = User.Identity?.Name ?? "Người dùng";
    string userInitial = displayName.Length > 0 ? displayName[..1].ToUpperInvariant() : "U";
    string? avatarUrl = User.FindFirstValue("AvatarUrl");
    bool isAdmin = User.IsInRole("Admin");
    string roleDisplayName = isAdmin ? "Quản trị viên" : "Quản lý";

    (string Controller, string Icon, string Text, bool AdminOnly) L(string controller, string icon, string text, bool adminOnly = false) =>
        (controller, icon, text, adminOnly);

    // Menu ngang theo mẫu Dwellr: mục chính hiện thẳng, nhóm nhiều trang thì gom vào menu thả xuống
    var tabs = new[]
    {
        (Text: "Tổng quan", Icon: "layout-grid", Links: new[] { L("Dashboard", "layout-grid", "Tổng quan") }),
        (Text: "Đơn thuê", Icon: "receipt", Links: new[] { L("Rental", "receipt", "Đơn thuê") }),
        (Text: "Đồ cho thuê", Icon: "package", Links: new[] { L("Item", "package", "Đồ cho thuê") }),
        (Text: "Khách hàng", Icon: "users", Links: new[] { L("Customer", "users", "Khách hàng") }),
        (Text: "Tài chính", Icon: "wallet", Links: new[]
        {
            L("Payment", "credit-card", "Thanh toán"),
            L("Wallet", "wallet", "Nạp / rút tiền", true)
        }),
        (Text: "Nội dung", Icon: "layout-list", Links: new[]
        {
            L("Category", "category", "Danh mục"),
            L("Banner", "photo", "Banner trang chủ"),
            L("Language", "language", "Ngôn ngữ")
        }),
        (Text: "Hệ thống", Icon: "settings", Links: new[]
        {
            L("User", "user-shield", "Tài khoản quản lý", true),
            L("AuditLog", "history", "Nhật ký hệ thống", true),
            L("Setting", "adjustments", "Cài đặt hệ thống", true)
        })
    };

    bool IsActive(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentMate Admin</title>
    <link rel="icon" href="~/favicon.ico" />

    @* Chế độ sáng / tối áp dụng trước khi vẽ trang để không bị nháy *@
    <script>
        try { if (localStorage.getItem("rm-theme") === "dark") document.documentElement.setAttribute("data-bs-theme", "dark"); } catch (e) { }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/tabler/css/tabler.min.css" />
    <link rel="stylesheet" href="~/lib/tabler-icons/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/rentmate.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
</head>
<body>
    <header class="rm-topbar">
        <div class="container-xl rm-topbar-inner">
            <a asp-area="Management" asp-controller="Dashboard" asp-action="Index" class="rm-logo" title="RentMate - Trang quản trị">RM</a>

            <button class="rm-nav-toggle d-xl-none" type="button" data-bs-toggle="collapse" data-bs-target="#rm-nav"
                    aria-controls="rm-nav" aria-expanded="false" aria-label="Mở menu">
                <i class="ti ti-menu-2"></i>
            </button>

            <nav class="collapse rm-nav-collapse" id="rm-nav">
                <ul class="rm-nav">
                    @foreach (var tab in tabs)
                    {
                        var links = tab.Links.Where(l => !l.AdminOnly || isAdmin).ToList();
                        if (links.Count == 0) continue;
                        bool active = links.Any(l => IsActive(l.Controller));

                        if (tab.Links.Length == 1)
                        {
                            <li>
                                <a class="rm-nav-link @(active ? "active" : "")" asp-area="Management" asp-controller="@links[0].Controller" asp-action="Index"
                                   aria-current="@(active ? "page" : null)">
                                    <i class="ti ti-@tab.Icon"></i><span>@tab.Text</span>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="dropdown">
                                <a href="#" class="rm-nav-link dropdown-toggle @(active ? "active" : "")" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="ti ti-@tab.Icon"></i><span>@tab.Text</span>
                                </a>
                                <div class="dropdown-menu rm-menu">
                                    @foreach (var link in links)
                                    {
                                        <a class="dropdown-item @(IsActive(link.Controller) ? "active" : "")" asp-area="Management" asp-controller="@link.Controller" asp-action="Index">
                                            <i class="ti ti-@link.Icon"></i>@link.Text
                                        </a>
                                    }
                                </div>
                            </li>
                        }
                    }
                </ul>
            </nav>

            <div class="rm-topbar-end">
                <button type="button" class="rm-icon-pill" data-theme-toggle title="Chuyển chế độ sáng / tối" aria-label="Chuyển chế độ sáng hoặc tối">
                    <i class="ti ti-moon rm-theme-dark"></i>
                    <i class="ti ti-sun rm-theme-light"></i>
                </button>

                <div class="dropdown">
                    <button type="button" class="rm-account" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="rm-account-text d-none d-md-flex">
                            <strong id="currentUserName">@displayName</strong>
                            <small>@roleDisplayName</small>
                        </span>
                        <span class="rm-avatar" id="currentUserAvatar" data-initial="@userInitial">@if (!string.IsNullOrEmpty(avatarUrl)) { <img src="@avatarUrl" alt="Ảnh đại diện" /> } else { @userInitial }</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end rm-menu">
                        <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#accountProfileModal">
                            <i class="ti ti-user-circle"></i>Thông tin tài khoản
                        </button>
                        <div class="dropdown-divider"></div>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item text-danger"><i class="ti ti-logout"></i>Đăng xuất</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger admin-toast" role="alert">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success admin-toast" role="status">@TempData["Success"]</div>
    }

    <main class="container-xl rm-content">
        @RenderBody()
    </main>

    <partial name="_AccountProfileModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/tabler/js/tabler.min.js"></script>
    <script>
        // Tabler đóng gói sẵn Bootstrap; các file js cũ gọi bootstrap.Modal nên gán lại biến toàn cục
        window.bootstrap = window.bootstrap || (window.tabler && window.tabler.bootstrap);
    </script>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin-ui.js" asp-append-version="true"></script>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
    <script src="~/js/edit-modal.js" asp-append-version="true"></script>
    <script src="~/js/account-profile.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
