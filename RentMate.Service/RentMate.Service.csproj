<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dùng các extension async của LINQ (ToListAsync, Include, ...) trên IQueryable từ repository -->
    <PackageReference Include="Anthropic" Version="13.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.32" />
  </ItemGroup>

  <ItemGroup>
    <!-- Câu chữ gốc của app kèm bản tiếng Anh, nạp vào database ở trang quản trị Ngôn ngữ -->
    <EmbeddedResource Include="Resources\app-texts.en.json" LogicalName="RentMate.Service.Resources.app-texts.en.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RentMate.Core\RentMate.Core.csproj" />
  </ItemGroup>

</Project>
